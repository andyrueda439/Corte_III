<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="640.0" prefWidth="900.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.ejercicioc3.controller.LaboratorioController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    <children>

        <Label text="Control de equipos de laboratorio">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- ================= FORMULARIO ================= -->
        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="90.0" prefWidth="90.0" />
                <ColumnConstraints minWidth="200.0" prefWidth="240.0" />
                <ColumnConstraints minWidth="90.0" prefWidth="90.0" />
                <ColumnConstraints minWidth="200.0" prefWidth="240.0" />
            </columnConstraints>

            <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtCodigo" promptText="Ej. EQ-009" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" promptText="Nombre del equipo" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label text="Marca:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtMarca" promptText="Marca" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Cantidad:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="txtCantidad" promptText="Número entero" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbTipo" prefWidth="240.0" promptText="Seleccione el tipo" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbEstado" prefWidth="240.0" promptText="Seleccione el estado" GridPane.columnIndex="3" GridPane.rowIndex="2" />
        </GridPane>

        <!-- ================= BOTONES CRUD ================= -->
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" text="Guardar" />
                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizar" text="Actualizar" />
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminar" text="Eliminar" />
                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" text="Limpiar" />
            </children>
        </HBox>

        <!-- ================= BUSQUEDA Y FILTRO ================= -->
        <Label text="Búsqueda y filtros">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
            <VBox.margin>
                <Insets top="8.0" />
            </VBox.margin>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Nombre:" />
                <TextField fx:id="txtBuscar" prefWidth="220.0" promptText="Buscar por nombre (parcial)" />
                <Label text="Tipo:" />
                <ComboBox fx:id="cmbFiltroTipo" prefWidth="200.0" promptText="Todos los tipos" />
                <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscar" text="Buscar / Aplicar filtros" />
                <Button fx:id="btnQuitarFiltros" mnemonicParsing="false" onAction="#quitarFiltros" text="Quitar filtros" />
            </children>
        </HBox>

        <!-- ================= TABLA ================= -->
        <TableView fx:id="tblEquipos" prefHeight="330.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colCodigo" prefWidth="95.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="215.0" text="Nombre" />
                <TableColumn fx:id="colMarca" prefWidth="110.0" text="Marca" />
                <TableColumn fx:id="colEstado" prefWidth="140.0" text="Estado" />
                <TableColumn fx:id="colCantidad" prefWidth="80.0" text="Cantidad" />
                <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
            </columns>
        </TableView>

    </children>
</VBox>